<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#D9081215" />
            <stroke android:width="1dp" android:color="#3F26B981" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <gradient android:angle="315" android:startColor="#122B5A49" android:centerColor="#090A1019" android:endColor="#12277761" />
            <stroke android:width="1dp" android:color="#8158F6B3" />
        </shape>
    </item>
</layer-list>
