<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#161F2A" />
                    <stroke android:width="2dp" android:color="#D9EAF6FF" />
                </shape>
            </item>
            <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
                <shape android:shape="oval">
                    <gradient android:angle="315" android:startColor="#AA6F55FF" android:centerColor="#AA36C5FF" android:endColor="#AA45E8BA" />
                    <stroke android:width="1dp" android:color="#EEFFFFFF" />
                </shape>
            </item>
            <item android:left="15dp" android:top="15dp" android:right="15dp" android:bottom="15dp">
                <shape android:shape="oval">
                    <solid android:color="#D80A111A" />
                    <stroke android:width="1dp" android:color="#9A85F5E1" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#101824" />
                    <stroke android:width="1dp" android:color="#718AA6BF" />
                </shape>
            </item>
            <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
                <shape android:shape="oval">
                    <gradient android:angle="315" android:startColor="#8A735CFF" android:centerColor="#8A3AC4FF" android:endColor="#8A43E5B3" />
                    <stroke android:width="1dp" android:color="#BBDCEEFF" />
                </shape>
            </item>
            <item android:left="14dp" android:top="14dp" android:right="14dp" android:bottom="14dp">
                <shape android:shape="oval">
                    <solid android:color="#E10A111A" />
                    <stroke android:width="1dp" android:color="#7584EED7" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
