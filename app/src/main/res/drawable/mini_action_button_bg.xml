<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#20324755" />
            <stroke android:width="1dp" android:color="#8A83D5CF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="315" android:startColor="#1515212D" android:endColor="#12112029" />
            <stroke android:width="1dp" android:color="#46597770" />
        </shape>
    </item>
</selector>
