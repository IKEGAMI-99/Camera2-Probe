<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#73314358" />
            <stroke android:width="1dp" android:color="#C175F9FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="315" android:startColor="#4A231938" android:endColor="#4A102D31" />
            <stroke android:width="1dp" android:color="#695DDAE8" />
        </shape>
    </item>
</selector>
