<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#D90A0F18" />
            <stroke android:width="1dp" android:color="#446F55D9" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <gradient android:angle="315" android:startColor="#183C2D6D" android:centerColor="#090A1019" android:endColor="#182A5A78" />
            <stroke android:width="1dp" android:color="#8C9A78FF" />
        </shape>
    </item>
</layer-list>
