<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#11091F"
                android:centerColor="#07172B"
                android:endColor="#041A17" />
        </shape>
    </item>
    <item android:left="-80dp" android:top="-160dp" android:right="120dp" android:bottom="480dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:startColor="#506D35FF"
                android:centerColor="#186D35FF"
                android:endColor="#006D35FF" />
        </shape>
    </item>
    <item android:left="180dp" android:top="40dp" android:right="-120dp" android:bottom="300dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="240dp"
                android:startColor="#4043C9FF"
                android:centerColor="#1243C9FF"
                android:endColor="#0043C9FF" />
        </shape>
    </item>
    <item android:left="-100dp" android:top="420dp" android:right="180dp" android:bottom="-120dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="280dp"
                android:startColor="#3824FFB0"
                android:centerColor="#1024FFB0"
                android:endColor="#0024FFB0" />
        </shape>
    </item>
</layer-list>
