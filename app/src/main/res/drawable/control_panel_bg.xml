<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#E40A1018" />
            <stroke android:width="1dp" android:color="#334C6C88" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <gradient android:angle="315" android:startColor="#142C1F56" android:centerColor="#060A111A" android:endColor="#10205D67" />
            <stroke android:width="1dp" android:color="#5844C6D0" />
        </shape>
    </item>
</layer-list>
