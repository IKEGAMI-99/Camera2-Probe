<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="7dp"
    android:paddingEnd="10dp"
    android:paddingBottom="9dp">

    <!-- Compact HUD header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.19"
                android:text="TRI // CAM"
                android:textColor="#F1F5FF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:background="@drawable/live_dot" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="INITIALIZING TRIPLE OPTICS"
                    android:textColor="#8595AA"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/linkBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/link_badge_bg"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:paddingStart="11dp"
            android:paddingTop="5dp"
            android:paddingEnd="11dp"
            android:paddingBottom="5dp"
            android:text="3× LINK"
            android:textColor="#65F4C7"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- 2 x 2 camera/control matrix -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="9dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- MAIN -->
            <FrameLayout
                android:id="@+id/mainFrame"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/neon_frame_main"
                android:padding="3dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/preview_clip_bg"
                    android:clipToOutline="true"
                    android:outlineProvider="background">

                    <TextureView
                        android:id="@+id/previewMain"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <TextView
                    android:id="@+id/labelMain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="9dp"
                    android:background="@drawable/lens_badge_main"
                    android:drawablePadding="6dp"
                    android:drawableStart="@drawable/ic_optic"
                    android:drawableTint="#A58BFF"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="9dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="MAIN\n-- fps"
                    android:textColor="#F0ECFF"
                    android:textSize="9sp" />
            </FrameLayout>

            <!-- ULTRA -->
            <FrameLayout
                android:id="@+id/ultraFrame"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/neon_frame_ultra"
                android:padding="3dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/preview_clip_bg"
                    android:clipToOutline="true"
                    android:outlineProvider="background">

                    <TextureView
                        android:id="@+id/previewUltra"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <TextView
                    android:id="@+id/labelUltra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="9dp"
                    android:background="@drawable/lens_badge_ultra"
                    android:drawablePadding="6dp"
                    android:drawableStart="@drawable/ic_optic"
                    android:drawableTint="#4DEBFF"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="9dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="ULTRA\n-- fps"
                    android:textColor="#E9FCFF"
                    android:textSize="9sp" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- TELE -->
            <FrameLayout
                android:id="@+id/teleFrame"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/neon_frame_tele"
                android:padding="3dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/preview_clip_bg"
                    android:clipToOutline="true"
                    android:outlineProvider="background">

                    <TextureView
                        android:id="@+id/previewTele"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <TextView
                    android:id="@+id/labelTele"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="9dp"
                    android:background="@drawable/lens_badge_tele"
                    android:drawablePadding="6dp"
                    android:drawableStart="@drawable/ic_optic"
                    android:drawableTint="#58F6B3"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="9dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="TELE\n-- fps"
                    android:textColor="#ECFFF6"
                    android:textSize="9sp" />
            </FrameLayout>

            <!-- CONTROL DECK -->
            <FrameLayout
                android:id="@+id/controlPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/control_panel_bg"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.15"
                                android:text="SYNC CAPTURE"
                                android:textColor="#C6D3E2"
                                android:textSize="8sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="THREE OPTICAL CHANNELS"
                                android:textColor="#4F657A"
                                android:textSize="6.5sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="●  LIVE"
                            android:textColor="#55EFB9"
                            android:textSize="7sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="150dp"
                        android:layout_height="124dp"
                        android:layout_marginTop="7dp">

                        <!-- Requested: small button at upper-left of shutter -->
                        <LinearLayout
                            android:id="@+id/allAfButton"
                            android:layout_width="64dp"
                            android:layout_height="38dp"
                            android:layout_gravity="top|start"
                            android:background="@drawable/all_af_button_bg"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingHorizontal="8dp">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_focus_all"
                                android:tint="#63F5D1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="ALL AF"
                                android:textColor="#D6FFF5"
                                android:textSize="7.5sp" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/captureButton"
                            android:layout_width="98dp"
                            android:layout_height="98dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/shutter_button_bg"
                            android:contentDescription="Capture all three cameras"
                            android:padding="27dp"
                            android:src="@drawable/ic_shutter"
                            android:tint="#F7FBFF" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/captureInfoText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="MAX JPEG × 3"
                        android:textColor="#60748A"
                        android:textSize="7sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="62dp"
                            android:layout_height="72dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageButton
                                android:id="@+id/settingsButton"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/mini_action_button_bg"
                                android:contentDescription="Settings"
                                android:padding="13dp"
                                android:src="@drawable/ic_settings"
                                android:tint="#B6A5FF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="SYSTEM"
                                android:textColor="#5D7083"
                                android:textSize="6.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="62dp"
                            android:layout_height="72dp"
                            android:layout_marginStart="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <ImageButton
                                android:id="@+id/galleryButton"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/mini_action_button_bg"
                                android:contentDescription="Gallery"
                                android:padding="13dp"
                                android:src="@drawable/ic_gallery"
                                android:tint="#5CF1BF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="MEDIA"
                                android:textColor="#5D7083"
                                android:textSize="6.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:letterSpacing="0.11"
                        android:text="1080P / 30  ·  3A LINKED"
                        android:textColor="#435A6F"
                        android:textSize="6.5sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/diagnosticPanel"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/diagnostic_bg"
        android:fillViewport="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="#72FFCB"
            android:textIsSelectable="true"
            android:textSize="9sp" />
    </ScrollView>
</LinearLayout>
