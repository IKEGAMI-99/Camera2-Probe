<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:shadowColor="#AA704CFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10"
                android:text="TRI // CAM"
                android:textColor="#EAF9FF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="INITIALIZING TRIPLE OPTICS"
                android:textColor="#9BB7CE"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/linkBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/link_badge_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="3× LINK"
            android:textColor="#71FFD2"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/mainFrame"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/neon_frame_main"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:padding="5dp">

                <TextureView
                    android:id="@+id/previewMain"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/labelMain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="8dp"
                    android:background="@drawable/lens_badge_main"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="9dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="5dp"
                    android:text="MAIN\n-- fps"
                    android:textColor="#E9E6FF"
                    android:textSize="10sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/ultraFrame"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/neon_frame_ultra"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:padding="5dp">

                <TextureView
                    android:id="@+id/previewUltra"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/labelUltra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="8dp"
                    android:background="@drawable/lens_badge_ultra"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="9dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="5dp"
                    android:text="ULTRA\n-- fps"
                    android:textColor="#DFFBFF"
                    android:textSize="10sp" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/teleFrame"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/neon_frame_tele"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:padding="5dp">

                <TextureView
                    android:id="@+id/previewTele"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/labelTele"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="8dp"
                    android:background="@drawable/lens_badge_tele"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="9dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="5dp"
                    android:text="TELE\n-- fps"
                    android:textColor="#E1FFEF"
                    android:textSize="10sp" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/controlPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/control_panel_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:text="TRIPLE CAPTURE"
                    android:textColor="#A8C5D8"
                    android:textSize="9sp" />

                <ImageButton
                    android:id="@+id/captureButton"
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/shutter_button_bg"
                    android:contentDescription="Capture all three cameras"
                    android:padding="18dp"
                    android:src="@drawable/ic_shutter"
                    android:tint="#F4FCFF" />

                <TextView
                    android:id="@+id/captureInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="MAX JPEG × 3"
                    android:textColor="#71899C"
                    android:textSize="8sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/settingsButton"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/mini_action_button_bg"
                        android:contentDescription="Settings"
                        android:padding="16dp"
                        android:src="@drawable/ic_settings"
                        android:tint="#BCAEFF" />

                    <ImageButton
                        android:id="@+id/galleryButton"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/mini_action_button_bg"
                        android:contentDescription="Gallery"
                        android:padding="16dp"
                        android:src="@drawable/ic_gallery"
                        android:tint="#6DFFCF" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="1080P PREVIEW"
                    android:textColor="#567184"
                    android:textSize="8sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/diagnosticPanel"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/diagnostic_bg"
        android:fillViewport="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="10dp"
            android:textColor="#72FFCB"
            android:textIsSelectable="true"
            android:textSize="9sp" />
    </ScrollView>
</LinearLayout>
